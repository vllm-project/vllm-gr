{
  "model_type": "hstu",
  "architectures": ["HSTUEmbeddingModel"],

  "is_text_encoder": true,
  "is_encoder_decoder": false,
  "is_attention_free": false,

  "max_seq_len": 128,
  "max_num_candidates": 50,

  "hstu_num_heads": 2,
  "hstu_attn_linear_dim": 64,
  "hstu_attn_qk_dim": 32,
  "hstu_attn_num_layers": 2,
  "hstu_embedding_table_dim": 64,
  "hstu_preprocessor_hidden_dim": 128,
  "hstu_transducer_embedding_dim": 64,

  "contextual_feature_to_max_length": {
    "viewer_id": 1, "dummy_contextual": 1
  },
  "contextual_feature_to_min_uih_length": {
    "viewer_id": 128, "dummy_contextual": 128
  },

  "candidates_weight_feature_name": "item_action_weight",
  "candidates_watchtime_feature_name": "item_target_watchtime",
  "candidates_querytime_feature_name": "item_query_time",

  "user_embedding_feature_names": [
    "uih_post_id", "uih_owner_id", "viewer_id", "dummy_contextual"
  ],
  "item_embedding_feature_names": ["item_post_id", "item_owner_id"],
  "uih_post_id_feature_name": "uih_post_id",
  "uih_action_time_feature_name": "uih_action_time",
  "uih_weight_feature_name": "uih_weight",

  "hstu_uih_feature_names": [
    "uih_post_id", "uih_action_time", "uih_weight",
    "uih_owner_id", "uih_watchtime", "uih_surface_type",
    "uih_video_length", "viewer_id", "dummy_contextual"
  ],
  "hstu_candidate_feature_names": [
    "item_post_id", "item_owner_id",
    "item_surface_type", "item_video_length",
    "item_action_weight", "item_target_watchtime", "item_query_time"
  ],

  "merge_uih_candidate_feature_mapping": [
    ["uih_post_id", "item_post_id"],
    ["uih_owner_id", "item_owner_id"],
    ["uih_action_time", "item_query_time"],
    ["uih_weight", "item_action_weight"],
    ["uih_watchtime", "item_target_watchtime"],
    ["uih_video_length", "item_video_length"],
    ["uih_surface_type", "item_surface_type"]
  ],

  "hash_size": 10000,
  "task_names": ["vvp100"],
  "task_types": ["binary_classification"],

  "embedding_tables": [
    {
      "name": "post_id",
      "embedding_dim": 64,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": [
        "uih_post_id", "item_post_id",
        "uih_owner_id", "item_owner_id"
      ]
    },
    {
      "name": "viewer_id",
      "embedding_dim": 64,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": ["viewer_id"]
    },
    {
      "name": "dummy_contextual",
      "embedding_dim": 64,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": ["dummy_contextual"]
    }
  ]
}
